<Window x:Class="SultanStore.EditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать товар"
        Height="436"
        Width="560"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        ResizeMode="NoResize">

    <Window.Resources>

        <!-- 🔥 Стиль TextBox -->
        <Style TargetType="TextBox">

            <!-- Цвет текста -->
            <Setter Property="Foreground" Value="White"/>

            <!-- Фон -->
            <Setter Property="Background" Value="#1A1A1A"/>

            <!-- Золотая рамка -->
            <Setter Property="BorderBrush" Value="#D4AF37"/>

            <!-- Толщина рамки -->
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Высота -->
            <Setter Property="Height" Value="35"/>

            <!-- Отступ -->
            <Setter Property="Padding" Value="8"/>

            <!-- Размер текста -->
            <Setter Property="FontSize" Value="14"/>

            <!-- Внешний отступ -->
            <Setter Property="Margin" Value="0,0,0,15"/>

        </Style>

        <!-- 🔥 Стиль текста -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 🔥 Стиль кнопки -->
        <Style TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#D4AF37"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </Window.Resources>

    <Border Margin="15"
            Background="#1E1E1E"
            CornerRadius="15"
            Padding="20">

        <StackPanel>

            <!-- Заголовок -->
            <TextBlock Text="Редактирование товара"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#D4AF37"
                       Margin="0,0,0,20"/>

            <!-- Название -->
            <TextBlock Text="Название"/>
            <TextBox x:Name="nameBox"/>

            <!-- Цена -->
            <TextBlock Text="Цена"/>
            <TextBox x:Name="priceBox"/>

            <!-- Количество -->
            <TextBlock Text="Количество"/>
            <TextBox x:Name="qtyBox"/>

            <!-- Кнопка -->
            <Button Content="💾 Сохранить"
                    Margin="0,10,0,0"
                    Click="SaveChanges"/>

        </StackPanel>

    </Border>

</Window>