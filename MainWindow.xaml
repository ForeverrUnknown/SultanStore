<Window x:Class="SultanStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sultan Store" Height="450" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F">

    <!-- 🔥 ВАЖНО: стиль должен быть тут -->
    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="250"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#D4AF37"/>
            <Setter Property="BorderThickness" Value="2"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#D4AF37"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- Основной UI -->
    <Grid>

        <!-- Верх -->
        <Border Background="#2B2B2B" Height="80" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20">

                <Image Source="logoname.png"
                   Height="40"
                   Stretch="Uniform"/>
                
                <TextBlock Text=" STORE"
                           Foreground="White"
                           FontSize="23"
                           FontWeight="Bold" Margin="-2,-0.4,0,0"/>

            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,115,0,0">

            <Button Content="📦 Склад"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="OpenWarehouse"/>

            <Button Content="💰 Продажи"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="OpenSales"/>

            <Button Content="🚚 Поставщики"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="OpenSuppliers"/>

            <Button Content="🧾 История продаж"
                    Style="{StaticResource MenuButtonStyle}"
                    Click="OpenHistory"/>

        </StackPanel>
        <Border HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="0,0,10,10"
        Background="#15000000"
        CornerRadius="5"
        Padding="8,4">

            <TextBlock Text="Работу выполнил&#x0A;Студент группы ИС-41&#x0A;Гой Герман Олегович"
               Foreground="#8C8C8C"
               FontSize="10"
               TextAlignment="Right"/>

        </Border>
    </Grid>
</Window>