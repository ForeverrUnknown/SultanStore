 <Window x:Class="SultanStore.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Заказ товара"
        Height="650" Width="1100"
        Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 🎨 Цвета -->
        <SolidColorBrush x:Key="card" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="gold" Color="#d4af37"/>

        <!-- 🔥 DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
        </Style>

        <Style TargetType="DataGridRowHeader">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#d4af37"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 🔥 КНОПКИ -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#d4af37"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 🔥 TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#d4af37"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
        <!-- 🔥 КРАСИВЫЙ СКРОЛЛ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#1e1e1e"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="#1e1e1e">

                            <Track x:Name="PART_Track">

                                <Track.Thumb>
                                    <Thumb>

                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">

                                                <Border Background="#d4af37"
                                                CornerRadius="5"
                                                Margin="1"/>

                                            </ControlTemplate>
                                        </Thumb.Template>

                                    </Thumb>
                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔥 ВЕРХ -->
        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,15">

            <Border Width="70" Height="70"
                    CornerRadius="35"
                    Background="#1e1e1e"
                    Padding="5"
                    Margin="0,0,15,0">
                <Image Source="logo.png" Stretch="Uniform"/>
            </Border>

            <TextBlock Text="Оформление заказа"
                       FontSize="26"
                       Foreground="#d4af37"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 🔍 ПОИСК -->
        <TextBox x:Name="searchBox"
                 Grid.Row="1"
                 Width="300"
                 Height="35"
                 TextChanged="SearchChanged"
                 ToolTip="Поиск товара"/>

        <!-- 📦 ТОВАРЫ -->
        <Border Grid.Row="2"
                Background="#1e1e1e"
                CornerRadius="15"
                Padding="10"
                Margin="0,10,10,0">

            <DataGrid x:Name="gridProducts"
          AutoGenerateColumns="False"
          Background="#1e1e1e"
          Foreground="White"
          BorderThickness="0"
          GridLinesVisibility="None"
          HeadersVisibility="Column"
          RowHeaderWidth="0"
          IsReadOnly="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          SelectionUnit="FullRow"
          HorizontalScrollBarVisibility="Auto"
          VerticalScrollBarVisibility="Auto">

                <!-- 🔥 СТИЛЬ СТРОК -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="#1e1e1e"/>
                        <Setter Property="Foreground" Value="White"/>

                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#333333"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- 🔥 ЯЧЕЙКИ -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="8"/>
                        <Setter Property="FontSize" Value="14"/>
                    </Style>
                </DataGrid.CellStyle>

                <!-- 🔥 ЗАГОЛОВКИ -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#d4af37"/>
                        <Setter Property="Foreground" Value="Black"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="15"/>
                        <Setter Property="Height" Value="35"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                            Binding="{Binding ProductID}"
                            Width="70"/>

                    <DataGridTextColumn Header="Название"
                            Binding="{Binding Name}"
                            Width="250"/>

                    <DataGridTextColumn Header="Категория ID"
                            Binding="{Binding CategoryID}"
                            Width="140"/>

                    <DataGridTextColumn Header="Поставщик ID"
                            Binding="{Binding SupplierID}"
                            Width="150"/>

                    <DataGridTextColumn Header="Цена"
                            Binding="{Binding Price}"
                            Width="100"/>

                    <DataGridTextColumn Header="Количество"
                            Binding="{Binding Quantity}"
                            Width="130"/>

                    <DataGridTextColumn Header="Категория"
                            Binding="{Binding Category}"
                            Width="180"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- 🛒 КОРЗИНА -->
        <Border Grid.Column="1"
                Grid.Row="1"
                Grid.RowSpan="2"
                Background="#1e1e1e"
                CornerRadius="15"
                Padding="10"
                Margin="10,0,0,0">

            <StackPanel>

                <TextBlock Text="Корзина"
                           Foreground="#d4af37"
                           FontSize="18"
                           Margin="5"/>

                <ListBox x:Name="orderList"
                         Background="#1e1e1e"
                         Foreground="White"
                         BorderThickness="0"
                         Height="300"/>

                <TextBox x:Name="qtyBox"
                         Width="100"
                         ToolTip="Количество"/>

                <Button Content="Добавить"
                        Click="AddToOrder"/>
                
                <Button Content="Удалить товар" 
                        Click="RemoveItem"/>
                
                <Button Content="Создать заказ"
                        Click="CreateOrder"/>

            </StackPanel>

        </Border>

    </Grid>
</Window>