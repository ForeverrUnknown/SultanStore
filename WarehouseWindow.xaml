<Window x:Class="SultanStore.WarehouseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Склад"
        Height="550"
        Width="1100"
        Background="#121212"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- 🎨 Цвета -->
        <SolidColorBrush x:Key="CardColor" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="GoldColor" Color="#d4af37"/>

        <!-- 🔍 TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="BorderBrush" Value="#d4af37"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- 🔘 Кнопки -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Background" Value="#d4af37"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- 📦 Таблица -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>

        <!-- ❌ Убираем белые ячейки -->
        <Style TargetType="DataGridRowHeader">
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>

        <!-- 📄 Строки -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#1e1e1e"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Style.Triggers>

                <!-- 🔥 Выделение -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333333"/>
                </Trigger>

            </Style.Triggers>

        </Style>

        <!-- 📦 Ячейки -->
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <!-- 🏷 Заголовки -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#d4af37"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- 📜 ScrollBar -->
        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="10"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="#1e1e1e">

                            <Track Name="PART_Track">

                                <Track.Thumb>

                                    <Thumb Background="#d4af37"/>

                                </Track.Thumb>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 🔍 ПОИСК -->
        <StackPanel Orientation="Horizontal"
                    Grid.Row="0"
                    Margin="0,0,0,15">

            <TextBox x:Name="searchBox"
                     Width="250"
                     KeyDown="SearchKeyDown"
                     ToolTip="Поиск товара"/>

            <Button Content="Поиск"
                    Width="80"
                    Click="SearchButton_Click"/>

            <Button Content="Добавить товар"
                    Click="AddProduct"/>

            <Button Content="Удалить"
                    Click="DeleteProduct"/>

        </StackPanel>

        <!-- 🔥 НИЖНЯЯ ОБЛАСТЬ -->
        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>

                <!-- 📦 Таблица -->
                <ColumnDefinition Width="3*"/>

                <!-- 🏪 Правая панель -->
                <ColumnDefinition Width="1.2*"/>

            </Grid.ColumnDefinitions>

            <!-- 📦 ТАБЛИЦА -->
            <Border Grid.Column="0"
                    Background="#1e1e1e"
                    CornerRadius="15"
                    Padding="10"
                    Margin="0,0,10,0">

                <DataGrid x:Name="gridProducts"
                          AutoGenerateColumns="False"
                          MouseDoubleClick="EditProduct">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                            Binding="{Binding ProductID}"
                                            Width="60"/>

                        <DataGridTextColumn Header="Название"
                                            Binding="{Binding Name}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Цена"
                                            Binding="{Binding Price}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Количество"
                                            Binding="{Binding Quantity}"
                                            Width="120"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Border>

            <!-- 🏪 ПРАВАЯ ПАНЕЛЬ -->
            <Border Grid.Column="1"
                    Background="#1e1e1e"
                    CornerRadius="15"
                    Padding="20">

                <Grid>

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <!-- 🏪 ЛОГО -->
                        <Image Source="logo.png"
                               Width="220"
                               Height="220"
                               Stretch="Uniform"
                               Margin="0,0,0,20"/>

                        <!-- 🏷 НАЗВАНИЕ -->
                        <TextBlock Text="SULTAN"
                                   Foreground="#d4af37"
                                   FontSize="32"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="Управление складом"
                                   Foreground="White"
                                   FontSize="16"
                                   Opacity="0.8"
                                   Margin="0,10,0,0"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Grid>

</Window>